{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && (python3 _скрипты/start.py || python _скрипты/start.py)",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
